# Copiar a .env y completar. Ninguna de estas claves es obligatoria para que
# watchdog corra: sin ellas simplemente se saltea el enriquecimiento
# correspondiente (queda todo en modo heuristico local).

# VirusTotal (free tier: 4 req/min) - https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# AlienVault OTX (gratis) - https://otx.alienvault.com/api
OTX_API_KEY=

# AbuseIPDB (free tier: 1000 req/dia) - https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Opcional: triage por LLM (ya usas esta key en genomic_agent/.env, podes reusarla)
OPENROUTER_API_KEY=

# Opcional: notificaciones push
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
