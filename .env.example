# Telegram Bot + Consensus Expert Agent — Environment Variables
# Copia este archivo a .env y completa los valores

# Telegram Bot (obtén el token de @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Chat ID(s) autorizados (separados por coma para múltiples)
# Obtén tu chat_id con @userinfobot
TELEGRAM_CHAT_ID=123456789

# Configuración del Consensus Agent
CONSENSUS_CONFIG=config.yaml

# Raíz de Sentinel Omega (para /status — solo lectura)
SENTINEL_OMEGA_ROOT=/home/deamon/workspaces/sentinel_omega

# Mini App (Telegram WebApp). MUST be public HTTPS — localhost is ignored.
# Example after tunnel/reverse-proxy: https://concilio.example.com/mini
TELEGRAM_WEBAPP_URL=

# Link shown in /reporte and miniapp (can be local while developing)
CONSENSUS_DASHBOARD_URL=http://127.0.0.1:8002
