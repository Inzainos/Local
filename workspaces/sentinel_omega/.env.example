# Sentinel Omega — Environment Variables Template
# Copy to .env and fill in your values. NEVER commit .env to git.

# ── Telegram Bot ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Crypto APIs ──────────────────────────────────────────────────────
BITSO_API_KEY=
BITSO_API_SECRET=
COINGECKO_API_KEY=

# ── Stock Market APIs ────────────────────────────────────────────────
ALPHA_VANTAGE_KEY=

# ── ESA Copernicus (Sentinel Satellites) ─────────────────────────────
COPERNICUS_USER=
COPERNICUS_PASSWORD=

# ── Weather ──────────────────────────────────────────────────────────
OPENWEATHERMAP_KEY=

# ── NASA ───────────────────────────────────────────────────────────
NASA_API_KEY=
# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
# ── Circuit Breaker ────────────────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60
# Consenso Padre (Telegram)
SENTINEL_DRY_RUN=1
TG_DIGEST_MINUTES=60
# HTTPS público del FastAPI dashboard /mini — Telegram Mini Apps no aceptan http/localhost.
# Este repo NO crea un túnel; expón el puerto 8787 tú (reverse proxy / Cloudflare).
TELEGRAM_WEBAPP_URL=
