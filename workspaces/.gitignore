# Base de datos local
*.db
*.sqlite
*.sqlite3

# Entornos virtuales
venv/
__pycache__/
*.pyc

# Archivos de ejecución y logs
*.log
.DS_Store
.streamlit/

# secrets ? never push
.env
.env.*
!.env.example
*.pem

# audit cleanup 2026-09-13
*.bak*
*_backup_*
launcher_hex_backup_*/
.agents/

# Excepción: los scripts de operación SÍ se versionan aunque su nombre lleve
# "backup". Sin esto, `deploy/offbox_backup_db.sh` casaba con `*_backup_*` y
# `git add -A` lo descartaba en silencio — el mismo patrón demasiado ancho que
# provocó el borrado de las copias de `data/` el 2026-09-13.
!deploy/*.sh
!deploy/hooks/*
!scripts/*.sh
