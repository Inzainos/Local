[Unit]
Description=Sentinel Omega — Scheduler continuo
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
EnvironmentFile=-__REPO_DIR__/deploy/.env
ExecStart=__REPO_DIR__/.venv/bin/python -m sentinel_omega.infrastructure.pipeline.scheduler_reportes
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
