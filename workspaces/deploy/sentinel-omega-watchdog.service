
[Unit]
Description=Sentinel Omega — Watchdog red y agente (auto-levanta sistema)
After=network-online.target sentinel-omega.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
EnvironmentFile=-__REPO_DIR__/deploy/.env
ExecStart=__REPO_DIR__/.venv/bin/python -m sentinel_omega.infrastructure.watchdog.network_watchdog
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
