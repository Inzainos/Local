#!/usr/bin/env python3
"""Hook de pre-commit: rechaza texto con acentos mutilados.

Por qué existe (2026-09-13): el pipeline de escritura de un agente emitió
ASCII en vez de UTF-8 y convirtió cada carácter no-ASCII en `?`. Quedaron
"Auditor?a", "Can?nico", "H1?H6", "remediaci?n" en documentación ya
commiteada, y en dos mensajes de commit que ya no se pueden arreglar sin
reescribir la historia.

Arreglar los archivos a mano no impide que vuelva a pasar. Esto sí.

Qué detecta: un `?` en posiciones donde no puede estar en español bien escrito:

    - entre dos letras                        →  Auditor?a, id?ntico
    - entre letra/dígito, dentro de un token  →  H1?H6, 2026?2027
    - suelto entre palabras, tipo raya        →  `2026-09-13 ? Auditoría`

**En prosa (`.md`, `.txt`) revisa siempre**, aunque el archivo ya tenga acentos
correctos. Un archivo se edita muchas veces y basta con que UNA escritura salga
en ASCII para mutilar las líneas nuevas dejando intactas las viejas: fue
exactamente lo que pasó con el CHANGELOG que motivó esto.

**En código (`.py`, `.sh`, `.yml`…) solo revisa si el archivo es ASCII puro.**
Ahí `re.compile(r"a?b")` es legítimo y daría falso positivo, así que se exige la
firma completa del pipeline roto antes de bloquear.

Qué NO detecta (a propósito, para no dar falsos positivos):
    - `¿...?` de preguntas normales y `?` final de frase
    - `?` dentro de URLs, query strings y código entre backticks
    - mutilación dentro de un archivo de código que ya tiene algún no-ASCII

Instalación:

    # Desde la raíz del checkout de la rama local/sentinel-omega:
    chmod +x workspaces/deploy/hooks/pre-commit-utf8
    ln -sf ../../workspaces/deploy/hooks/pre-commit-utf8 .git/hooks/pre-commit

El destino del symlink se resuelve desde `.git/hooks/`, así que los `../../`
llevan a la raíz del checkout — donde el hook está bajo `workspaces/`, no
directamente en `deploy/`.

O, si ya tienes un pre-commit, añade esta línea dentro:

    python3 workspaces/deploy/hooks/pre-commit-utf8 || exit 1

Saltarlo en un caso legítimo:  git commit --no-verify

La causa de raíz está en el proceso que escribe, no aquí. Complementa el hook
con esto en el entorno del agente:

    export PYTHONIOENCODING=utf-8
    # y en el código:  open(ruta, "w", encoding="utf-8")
"""
import re
import subprocess
import sys

EXTENSIONES = {".md", ".txt", ".py", ".yml", ".yaml", ".json", ".sh", ".cfg", ".ini", ".toml"}
# Prosa: se revisa siempre, tenga o no caracteres no-ASCII. Ver revisar().
PROSA = {".md", ".txt"}

# Un `?` rodeado de letras o dígitos, o usado como raya entre palabras.
PATRONES = [
    (re.compile(r"[A-Za-z]\?[A-Za-z]"), "`?` entre dos letras (acento perdido)"),
    # Mezcla letra/dígito dentro de un mismo token: H1?H6, 2026?2027, v2?v3.
    (re.compile(r"[A-Za-z0-9]\?[A-Za-z0-9]"), "`?` dentro de una palabra o rango (raya perdida)"),
    # El lookbehind admite dígitos además de letras: el caso real que motivó
    # esto era `2026-09-13 ? Auditoría`, y con solo letras se escapaba.
    (re.compile(r"(?<=[a-zA-Z0-9]) \? (?=[a-zA-Z0-9])"), "`?` suelto entre palabras (raya perdida)"),
    (re.compile(r"[A-Za-z0-9]\?(?=[A-Z][a-z])"), "`?` antes de mayúscula (raya perdida)"),
]

# Las URLs llevan `?` legítimo en el query string (`pagina.html?id=5`), y los
# globs de shell lo usan como comodín (`h0?.hex`). Se recortan de la línea
# antes de buscar, para no marcarlos.
RUIDO = re.compile(
    r"""https?://\S+            # enlaces
      | \bwww\.\S+              # enlaces sin esquema
      | \S+\?[\w.\-]+=[^\s)\]]* # cualquier token con query string
      | `[^`]*`                 # código entre backticks: puede tener globs
    """,
    re.VERBOSE,
)


def archivos_en_stage():
    salida = subprocess.run(
        # Incluye R (renames): un archivo que se renombra y de paso recibe el
        # `?` mutilado pasaba sin que revisar() lo viera.
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
        capture_output=True, text=True, check=True,
    ).stdout
    return [l for l in salida.splitlines() if l.strip()]


def contenido_en_stage(ruta):
    r = subprocess.run(["git", "show", f":{ruta}"], capture_output=True)
    return r.stdout if r.returncode == 0 else None


def revisar(ruta, crudo):
    try:
        texto = crudo.decode("utf-8")
    except UnicodeDecodeError:
        return [(0, "el archivo no es UTF-8 válido")]

    # Un archivo se edita muchas veces, y basta con que UNA escritura salga en
    # ASCII para mutilar las líneas nuevas dejando intactas las viejas. Fue
    # exactamente lo que pasó: un CHANGELOG.md con acentos correctos recibió
    # encima líneas con `?`. Por eso la prosa se revisa siempre, mezclada o no.
    #
    # En código la cosa cambia: `re.compile(r"a?b")` es legítimo y daría falso
    # positivo. Ahí se conserva el criterio conservador — solo se revisa si el
    # archivo es ASCII puro, que es la firma del pipeline roto.
    es_prosa = any(ruta.endswith(e) for e in PROSA)
    if not es_prosa and any(ord(c) > 127 for c in texto):
        return []

    hallazgos = []
    for n, linea in enumerate(texto.splitlines(), 1):
        # Los `?` legítimos (URLs, query strings, globs en código) se sustituyen
        # por espacios del mismo largo, para no correr las posiciones.
        limpia = RUIDO.sub(lambda m: " " * len(m.group(0)), linea)
        for patron, motivo in PATRONES:
            m = patron.search(limpia)
            if m:
                hallazgos.append((n, f"{motivo}: …{linea[max(0, m.start() - 20):m.end() + 20]}…"))
                break
    return hallazgos


def main():
    problemas = {}
    for ruta in archivos_en_stage():
        if not any(ruta.endswith(e) for e in EXTENSIONES):
            continue
        crudo = contenido_en_stage(ruta)
        if crudo is None:
            continue
        hallazgos = revisar(ruta, crudo)
        if hallazgos:
            problemas[ruta] = hallazgos

    if not problemas:
        return 0

    print("\n\033[31mCommit detenido: texto con caracteres mutilados\033[0m\n")
    for ruta, hallazgos in problemas.items():
        print(f"  {ruta}")
        for n, motivo in hallazgos:
            print(f"    línea {n}: {motivo}")
    print(
        "\nHay `?` donde debería ir un acento o una raya. Suele significar que el\n"
        "proceso que escribió esas líneas no usó UTF-8. Revisa que la escritura\n"
        "lleve encoding=\"utf-8\" y que PYTHONIOENCODING esté puesto.\n"
        "\nSi el `?` es intencional: git commit --no-verify\n"
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
