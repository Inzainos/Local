[Unit]
Description=Sentinel Omega — Disciplina Juez
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO_DIR__
EnvironmentFile=-__REPO_DIR__/deploy/.env
ExecStart=__REPO_DIR__/.venv/bin/python -m sentinel_omega.launcher --disciplina
Nice=10

[Install]
WantedBy=multi-user.target
