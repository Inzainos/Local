# Sentinel Omega — ejemplos de crontab
# Ajustar rutas y usuario

# Barrido diario 03:00 (volcado 24h + mantenimiento)
0 3 * * * cd /opt/workspaces && .venv/bin/python -m sentinel_omega.launcher --barrido >> /var/log/sentinel-barrido.log 2>&1

# Disciplina / Juez cada 2h
0 */2 * * * cd /opt/workspaces && .venv/bin/python -m sentinel_omega.launcher --disciplina >> /var/log/sentinel-disciplina.log 2>&1

# Respaldo off-box de la DB 03:45 (después del barrido). Usa sqlite3 .backup,
# NO cp: copiar una SQLite en caliente con cp puede producir un archivo roto.
# Destino fuera del árbol del proyecto, retención por días y por nº de copias.
# Sin redirección a propósito: el script ya escribe logs/offbox_db.log, y
# añadir `>> archivo 2>&1` duplicaría cada línea.
45 3 * * * bash /opt/workspaces/deploy/offbox_backup_db.sh --verify
