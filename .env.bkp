# Consensus Expert Agent — Environment Variables
# Completa los valores marcados como TU_..._AQUI. Nunca subir a git.
# Telegram Bot (obtén el token de @BotFather)
TELEGRAM_BOT_TOKEN=TU_TELEGRAM_BOT_TOKEN_AQUI
# Chat ID(s) autorizados (separados por coma para múltiples)
TELEGRAM_CHAT_ID=TU_TELEGRAM_CHAT_ID_AQUI
# Configuración del Consensus Agent
CONSENSUS_CONFIG=config.yaml
# Raíz de Sentinel Omega (para /status — solo lectura)
SENTINEL_OMEGA_ROOT=/home/deamon/Sentinel_Omega/sentinel_omega
# Mini App (Telegram WebApp). MUST be public HTTPS — localhost is ignored.
TELEGRAM_WEBAPP_URL=
# Clave OPCIONAL de la Mini App
MINI_APP_KEY=
# Link shown in /reporte and miniapp (can be local while developing)
CONSENSUS_DASHBOARD_URL=http://127.0.0.1:8002
# ── Sello Omega (cuarentena cifrada) ─────────────────────────────────
SELLO_OMEGA_SEED=IqOhveQPyobdtCiQwn1L5z_2jmV30jVJ2dT782KzLtpxOS11KSwytWs3lyd-iGin
