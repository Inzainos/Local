[Unit]
Description=Consensus Expert Telegram Bot (Concilio)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=deamon
Group=deamon
WorkingDirectory=/home/deamon/consensus-expert-agent
Environment=HOME=/home/deamon
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/deamon/consensus-expert-agent/.env
ExecStart=/home/deamon/consensus-expert-agent/.venv/bin/python /home/deamon/consensus-expert-agent/telegram_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
